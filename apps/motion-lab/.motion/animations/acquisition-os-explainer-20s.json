{
  "name": "acquisition-os-explainer-20s",
  "description": "Cinematic 20-second Acquisition OS explainer: context, prospects, outreach, approval, deployment, milestones, report. Grayscale, house physics, no loops.",
  "choreography": {
    "acts": "title 0-2.5s, context 2.5-5s, network 5-8s, pipeline 8-11s, deploy 11-14.5s, milestones 14.5-17.5s, finale 17.5-20.05s",
    "pattern": "one op per mount (multi-keyframe enter-hold-exit) so overlapping delays never fight over start states",
    "physics": "bezier entrances/exits on mounts, waves-spring reveals, snappy approval pop",
    "end": "finale holds to 20050ms so export covers the full 20s"
  },
  "ops": [
    {
      "id": "scene-ao-1",
      "kind": "scene",
      "scene": {
        "elements": [
          {
            "key": "ao-title",
            "kind": "title",
            "act": 1,
            "eyebrow": "WAVES",
            "text": "ACQUISITION OS",
            "sub": "Choose. Rent. Operate."
          },
          {
            "key": "ao-context",
            "kind": "flow",
            "act": 2,
            "text": "YOUR CONTEXT",
            "items": [
              "CONTEXT",
              "MARKET",
              "AUDIENCE",
              "CRITERIA"
            ],
            "caption": "Give it your context."
          },
          {
            "key": "ao-network",
            "kind": "network",
            "act": 3,
            "count": 120,
            "highlight": [
              5,
