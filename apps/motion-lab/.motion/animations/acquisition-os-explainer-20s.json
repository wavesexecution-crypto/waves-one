            "items": [
              "DEPLOY",
              "REPLIES",
              "FOLLOW-UP"
            ]
          },
          {
            "key": "ao-ms",
            "kind": "milestones",
            "act": 6,
            "count": 3
          },
          {
            "key": "ao-finale",
            "kind": "title",
            "act": 7,
            "large": true,
            "eyebrow": "WAVES",
            "text": "ACQUISITION OS",
            "sub": "Choose. Rent. Operate."
          }
        ]
      }
