    "rhythm": "ORB → STATE → ORB per beat; persistent orb mount, dispersing/reforming dots",
    "acts": "intel 0.2-2.6s, crm 3-6.5s, notebook 10-12.9s, workflow 16-18.9s, finale 19-20.05s",
    "pattern": "one op per mount (multi-keyframe enter-hold-exit); cascades on child targets",
    "end": "finale holds to 20050ms so export covers the full 20s"
  },
