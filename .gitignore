# Motion Lab local runtime state (DB, voiceovers, exports, logs).
# Kept: .motion/gsap/*.json (spec sources), .motion/animations/ (library),
# public/gsap-state.json + public/motion-state.json (default live mirrors).
apps/motion-lab/.motion/motion.db*
apps/motion-lab/.motion/history.jsonl
apps/motion-lab/.motion/state.json
apps/motion-lab/.motion/techniques.json
apps/motion-lab/.motion/voiceovers/
apps/motion-lab/.motion/assets/
apps/motion-lab/.motion/briefs/
apps/motion-lab/.motion/references/
# Ad-hoc render output is scratch, but shipped reels are not: the render worker
# is dev-only middleware, so the MP4 is the Download button on the deployed site.
# `/*` (not `/`) so the four files below can be re-included.
apps/motion-lab/public/exports/*
!apps/motion-lab/public/exports/waves-brand-film-19s.mp4
!apps/motion-lab/public/exports/waves-brand-film-19s.json
!apps/motion-lab/public/exports/seai-launch-reel.mp4
!apps/motion-lab/public/exports/seai-launch-reel.json
!apps/motion-lab/public/exports/motion-lab-demo.mp4
!apps/motion-lab/public/exports/motion-lab-demo.json
apps/motion-lab/dist/
.vercel
.env*
