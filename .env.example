# WAVES Motion Lab — AI Motion (NVIDIA Cosmos3-Nano) configuration.
# Copy to .env (never commit real keys). Server-side only: no NEXT_PUBLIC_*,
# nothing here is ever sent to the browser.

# Cosmos video key (preferred): dedicated key for the Cosmos3-Nano
# entitlement, so video access lives apart from any shared key.
# Obtain at build.nvidia.com (Get API Key); keys start with nvapi-.
NVIDIA_COSMOS_API_KEY=

# Shared fallback, also used by prompt enhancement. Used for Cosmos only
# when NVIDIA_COSMOS_API_KEY is empty.
NVIDIA_API_KEY=

# Motion provider: cosmos (default, NVIDIA Cosmos3-Nano) | mock (local
# ffmpeg-synthesized stand-ins, no NVIDIA calls — for UI/CI iteration).
MOTION_PROVIDER=cosmos

# Override only to target the exact working request captured from the
# Playground (devtools → Network → copy as cURL), or a self-hosted NIM.
# NVIDIA_COSMOS_ENDPOINT=https://ai.api.nvidia.com/v1/cosmos/nvidia/cosmos3-nano

# Provider HTTP ceiling in ms (trial generations take minutes). Default 600000.
# NVIDIA_COSMOS_TIMEOUT_MS=600000

# Prompt-enhancement model (verified live; override if your account entitles
# a different chat/vision model, e.g. NVIDIA_CHAT_MODEL=nvidia/cosmos-reason2-8b).
# NVIDIA_CHAT_MODEL=meta/llama-3.2-11b-vision-instruct
# NVIDIA_CHAT_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_CHAT_TIMEOUT_MS=120000
