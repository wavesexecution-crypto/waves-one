# WAVES ONE — environment template (Neon PostgreSQL + Vercel).
# Copy to .env.local for local dev. On Vercel, set these per environment
# (Development / Preview / Production) in Project Settings → Environment
# Variables, backed by separate Neon branches/databases.
#
# SECURITY: every variable here is SERVER-ONLY. Never create
# NEXT_PUBLIC_DATABASE_URL / NEXT_PUBLIC_* secrets — the browser talks only
# to the /api routes, which run server-side (see src/lib/db.ts assertServer).

# --- Neon PostgreSQL (REQUIRED in production) -------------------------------
# Pooled connection (PgBouncer, `-pooler` host): all application traffic,
# including the Vercel serverless runtime. Prefer this at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.c-XX.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Direct (unpooled) connection: schema migrations ONLY (drizzle-kit).
# Never use the pooled URL for migrations. See drizzle.config.ts.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.c-XX.aws.neon.tech/neondb?sslmode=require"

# --- Owner gate (REQUIRED on any internet-reachable deployment) --------------
# When set, every /api/control/* request must carry it as a Bearer token.
# Unset only for the local dev loop (localhost binding is the boundary).
WAVES_OWNER_TOKEN=""

# --- Store selection (optional) ----------------------------------------------
# file  = local .waves/ files (default locally; hermetic dev/tests)
# db    = force Neon (local verification: WAVES_STORE=db npm test -- store-db)
# On Vercel (VERCEL=1) the Neon store is automatic — the filesystem is
# ephemeral there, so file state would silently vanish.
WAVES_STORE="file"

# --- Paths (optional, local dev) ----------------------------------------------
WAVES_STATE_DIR=".waves"
WAVES_WORKSPACE="workspace"
